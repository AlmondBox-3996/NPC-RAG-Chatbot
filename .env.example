APP_NAME=NPC RAG Chatbot
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

VECTOR_DB_PROVIDER=chromadb
VECTOR_DB_PATH=./data/chromadb
VECTOR_COLLECTION_NAME=game_lore

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
ENABLE_MOCK_LLM=true

PLAYER_STATE_PATH=./data/state/player_state.json
WORLD_STATE_PATH=./data/state/world_state.json
LORE_PATH=./data/lore
NPC_DATA_PATH=./data/npcs.json
ITEM_DATA_PATH=./data/items.json

TOP_K_RESULTS=4
NPC_NAME=Quartermaster Rowan
